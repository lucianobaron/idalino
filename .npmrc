# Idalino — npm config local
#
# Os scripts de lifecycle do npm são desativados porque este projeto
# pode ser instalado em ambientes restritos (sandbox). Todos os pacotes
# usados (Next.js, esbuild, sharp, Prisma) entregam binários prontos via
# dependências opcionais; o Prisma é gerado explicitamente com
# `npx prisma generate`.
ignore-scripts=true
