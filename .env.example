# ===== Idalino — variáveis de ambiente =====
# Copie este arquivo para .env e ajuste conforme necessário.

# Banco de dados (PostgreSQL via Docker — docker-compose.yml)
DATABASE_URL="postgresql://idalino:idalino@localhost:5432/idalino?schema=public"

# Painel administrativo
ADMIN_PASSWORD="idalino-admin"
ADMIN_SECRET="troque-este-segredo-por-um-valor-longo-e-aleatorio"
# Defina como true quando o site estiver em HTTPS (produção)
COOKIE_SECURE="false"

# Pagamentos: "mock" por enquanto (nenhum gateway real configurado)
PAYMENT_PROVIDER="mock"

# Taxa de entrega em centavos (R$ 15,00 = 1500)
DELIVERY_FEE_CENTS=1500
